# dashboard/.env.example  (.env.local로 복사해 값 채움. .env.local은 커밋 금지)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon(public) key. docs/SUPABASE_SETUP.md 4단계에서 기록해 둔 값>
# 업로드 크기 상한(바이트). Supabase Free 티어 파일당 한도 50MB. 마이그레이션 005의
# 버킷 file_size_limit과 같은 값을 유지해야 한다. Pro 승급 시 둘 다 함께 올린다
NEXT_PUBLIC_MAX_UPLOAD_BYTES=52428800
