# flatworker 설정 예시 — 이 파일을 복사해 .env로 저장한 뒤 값을 채운다.
#   cp .env.example .env
# 키 이름은 flatworker/config.py 정본과 정확히 일치한다(임의로 이름을 바꾸지 말 것).
# Supabase 프로젝트 준비 절차는 docs/SUPABASE_SETUP.md 참고.

# 필수 — Supabase 프로젝트 URL. Settings -> API -> Project URL에서 복사.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 필수 — service_role 키. Settings -> API에서 복사.
# 서버(워커) 전용 값이다 — 대시보드/브라우저 등 클라이언트 코드에는 절대 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 선택 — 원본 스캔·산출물을 저장할 로컬 디렉터리(worker/ 실행 위치 기준 상대경로 가능).
# 기본값: ../data
DATA_DIR=../data

# 선택 — 클레임할 잡이 없을 때 다음 폴링까지 대기하는 시간(초).
# 기본값: 3
POLL_INTERVAL_S=3

# 선택 — 이 워커 인스턴스 식별자(jobs.locked_by에 기록됨). 워커를 여러 대 띄울 때 구분용.
# 기본값: local-1
WORKER_ID=local-1

# 선택 — 파일 저장 백엔드. local(개발·테스트, DATA_DIR 사용) 또는 supabase(운영,
# Supabase Storage 버킷 3종 사용 — Dockerfile이 Railway 배포용으로 이 값을 강제한다).
# 기본값: local
STORAGE_BACKEND=local
